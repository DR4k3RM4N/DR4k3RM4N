# Copia este archivo a .env y ajusta los valores.
DEBUG=true
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
TIME_ZONE=America/Mexico_City

# Base de datos (por defecto SQLite). En producción usa Postgres:
# DATABASE_URL=postgres://usuario:password@host:5432/pulsolive

# IA (Claude). Sin esta llave la app usa el motor de reglas.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Stripe. Sin estas llaves, elegir plan funciona en "modo demo" (sin cobro).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Correo (recuperar contraseña)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PulsoLive <hola@tu-dominio.com>
