# Copia este archivo como .env y llena tus datos.

# --- Claude (obligatorio) ---
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de cada agente. Ya vienen los más baratos que dan buen resultado; solo cambia
# uno si ves que esa parte sale floja. Opciones: claude-haiku-5-5 (el más barato),
# claude-sonnet-5-5 (equilibrado), claude-opus-5-5 (el más listo y caro).
MODELO_IDEAS=claude-haiku-5-5
MODELO_INVESTIGAR=claude-haiku-5-5
MODELO_GUION=claude-haiku-5-5
MODELO_BLOG=claude-haiku-5-5
MODELO_EDICION=claude-haiku-5-5

# Búsqueda en internet barata: Serper (Google) y/o Tavily. Con una basta; con las dos es más completa.
# serper.dev (2,500 gratis, luego ~$0.001 c/u) · tavily.com (1,000 gratis al mes)
SERPER_API_KEY=
TAVILY_API_KEY=
# Precio por búsqueda para el contador: 0 mientras uses las gratis (Serper ~0.001 cuando se acaben)
PRECIO_SERPER=0
PRECIO_TAVILY=0
# Cuántas búsquedas hace Iván por app (máximo 8)
BUSQUEDAS_INVESTIGACION=8
# auto/siempre = buscar en internet (con Serper/Tavily siempre se busca porque es baratísimo) · nunca = solo Play Store
# Sin Serper/Tavily se usa la búsqueda de Claude (más cara) solo si las reseñas no bastan.
INVESTIGACION_WEB=auto
QUEJAS_SUFICIENTES=8

# --- Tu canal ---
CANAL_NOMBRE=Mi Canal
CANAL_PAIS=mx
CANAL_IDIOMA=es
# Cómo hablas: se le pasa al guionista para que suene a ti.
CANAL_ESTILO=Directo, con humor, hablo de tú, como amigo que te salva de perder tu tiempo. Saludo corto y al grano.

# --- Voz ---
# edge = gratis (voces de Microsoft). elevenlabs = tu voz clonada (de pago).
VOZ_MOTOR=edge
VOZ_EDGE=es-MX-JorgeNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- WordPress (blog) ---
# Usuarios > Perfil > Contraseñas de aplicación
WP_URL=https://tublog.com
WP_USUARIO=
WP_APP_PASSWORD=
# draft = queda como borrador para que lo revises; publish = se publica directo
WP_ESTADO=draft
# playstore = icono/portada de Play Store como imagen destacada; miniatura = la miniatura del video
WP_IMAGEN_DESTACADA=playstore
WP_CATEGORIA_ID=

# --- YouTube ---
# Descarga client_secret.json de Google Cloud Console (YouTube Data API v3, app de escritorio)
YT_CLIENT_SECRETS=client_secret.json
# private / unlisted / public
YT_PRIVACIDAD=private
YT_CATEGORIA=28

# --- Oficina en un servidor ---
# 1 = modo demo (simula las APIs, no gasta). Ponlo en 0 cuando ya llenaste tus claves.
OFICINA_DEMO=0
# Usuario y contraseña para entrar a la oficina desde internet (obligatoria en un servidor).
OFICINA_USUARIO=jefe
OFICINA_PASSWORD=
# Dirección pública de tu oficina (va en los avisos de Telegram).
OFICINA_URL=
# Paola busca ideas sola cada día a esta hora (vacío = solo cuando tú se lo pidas).
IDEAS_HORA=09:00
IDEAS_ZONA=America/Mexico_City
# Indicación fija para la búsqueda diaria (opcional).
IDEAS_GUIA=
# Días que se guarda el video en el servidor después de publicarlo (ya está en YouTube).
LIMPIAR_DIAS=30
# Tope de gasto en Claude por día (USD). Al llegar, los agentes paran y te avisan. 0 = sin tope.
LIMITE_DIARIO=1

# --- WhatsApp (opcional) — más fácil: python oficina.py --configurar-whatsapp ---
# Datos de developers.facebook.com → tu app → WhatsApp → Configuración de la API.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Tu número con lada, solo dígitos. Solo se aceptan mensajes de este número.
WHATSAPP_JEFE=
# Lo inventas tú (el asistente lo genera) y lo pegas igual en el webhook de Meta.
WHATSAPP_VERIFY_TOKEN=
# Plantilla aprobada en Meta para escribirte cuando no le has escrito en 24 h. Cuerpo: "Novedad de tu oficina: {{1}}"
WHATSAPP_PLANTILLA=novedad_oficina
WHATSAPP_IDIOMA=es_MX

# --- Telegram (gratis) — más fácil: python oficina.py --configurar-telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Qué te avisan por chat: importante (ideas, videos listos, publicados, problemas) · todo (también cada entrega)
AVISOS_NIVEL=importante
